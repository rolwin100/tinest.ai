# ── gotiny.ai local dev ──
GOTINY_ENV=local
GOTINY_LOG_LEVEL=INFO

# model servers (run as host uvicorn processes locally — see justfile)
GOTINY_TTS_URL=ws://127.0.0.1:8081
GOTINY_STT_URL=http://127.0.0.1:8082
GOTINY_LLM_BASE_URL=http://127.0.0.1:11434/v1
GOTINY_LLM_MODEL=qwen2.5:7b
GOTINY_LLM_API_KEY=not-needed-for-ollama

# default providers (name@semver — must exist in the registry)
GOTINY_TTS_PROVIDER=kokoro-http@1.0
GOTINY_STT_PROVIDER=whisper-http@1.0

# gateway
GOTINY_MAX_CONCURRENT_CALLS=4
GOTINY_WARM_POOL_SIZE=2

# control plane (week 2)
# GOTINY_DATABASE_URL=postgresql+asyncpg://gotiny:gotiny@127.0.0.1:5432/gotiny
# GOTINY_API_URL=http://127.0.0.1:8000
